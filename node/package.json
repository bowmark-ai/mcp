{
  "name": "@bowmark/mcp",
  "version": "2.1.2",
  "mcpName": "ai.bowmark/bowmark",
  "description": "Bowmark MCP for stdio hosts: web scraping and automation for AI agents. Live prices, quotes, bookings, anything behind a login. Starts with a free $10.",
  "license": "UNLICENSED",
  "author": "Bowmark AI <christopher@bowmark.ai>",
  "homepage": "https://bowmark.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bowmark-ai/mcp.git",
    "directory": "node"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "bowmark",
    "web-scraping",
    "web-data",
    "ai-agent-tools",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "bowmark": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/bridge.js",
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "~5.9.2"
  }
}
